# Server
NODE_ENV=development
PORT=5003

# Comma-separated browser origins allowed to call this API.
# Local Vite stays in the default. Add the Vercel URL when the domain is known.
# https://*.vercel.app is already allowed by the server in addition to this list.
CLIENT_ORIGINS=http://localhost:5173

# MongoDB connection string (either key is accepted)
MONGODB_URI=mongodb://127.0.0.1:27017/recipe_app
# MONGO_URI=mongodb://127.0.0.1:27017/recipe_app

# JWT signing secret — use a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret

# Demo account for recruiters (seeded on startup if missing)
DEMO_EMAIL=demo@gastronova.com
DEMO_PASSWORD=DemoUser123!
