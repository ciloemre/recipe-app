# Local development. Copy to frontend/.env if you want to override the defaults.
# Production builds read frontend/.env.production (https://gastronova-api.onrender.com).
# On Vercel, set the same two names in Project Settings → Environment Variables
# if the API host changes. Vercel values override .env.production.
VITE_API_URL=http://localhost:5003/api
VITE_SOCKET_URL=http://localhost:5003

# Demo login credentials (must match backend DEMO_* / seeded user)
VITE_DEMO_EMAIL=demo@gastronova.com
VITE_DEMO_PASSWORD=DemoUser123!
